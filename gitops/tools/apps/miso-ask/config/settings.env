# miso-ask: Open WebUI settings that are plain strings. JSON settings (connections, MCP servers,
# model defaults) are built by entrypoint.py. ENABLE_PERSISTENT_CONFIG=false: this file is the
# source of truth, admin UI edits do not persist.
ENABLE_PERSISTENT_CONFIG=false
WEBUI_NAME=MISO Lab
WEBUI_URL=https://miso-ask.phillips-homelab.net
DATA_DIR=/data
WEBUI_SECRET_KEY_FILE=/data/.webui_secret_key
# Open WebUI copies its frontend assets here at boot; the image root is read-only.
STATIC_DIR=/static
# No egress except api.anthropic.com: nothing may try to download models or check versions.
OFFLINE_MODE=true
HF_HUB_OFFLINE=1
ENABLE_VERSION_UPDATE_CHECK=false
ANONYMIZED_TELEMETRY=false
DO_NOT_TRACK=true
SCARF_NO_ANALYTICS=true
# Accounts: the first sign-up becomes admin (Casey, right after deploy); nobody else can sign up.
# Going public = Cloudflare Access in front + WEBUI_AUTH_TRUSTED_EMAIL_HEADER.
ENABLE_SIGNUP=false
DEFAULT_USER_ROLE=pending
ENABLE_API_KEYS=false
SHOW_ADMIN_DETAILS=false
ENABLE_PUBLIC_ACTIVE_USERS_COUNT=false
# Visitors' chats stay theirs: the admin cannot browse them.
ENABLE_ADMIN_CHAT_ACCESS=false
# Models: Claude only (entrypoint.py); every signed-in user sees them.
ENABLE_OLLAMA_API=false
ENABLE_OPENAI_API=true
ENABLE_DIRECT_CONNECTIONS=false
ENABLE_EVALUATION_ARENA_MODELS=false
BYPASS_MODEL_ACCESS_CONTROL=true
ENABLE_MESSAGE_RATING=false
ENABLE_COMMUNITY_SHARING=false
# Tools: the two iso-lab MCP servers only. No plugins, code, web, images, files, memory.
ENABLE_PLUGINS=false
ENABLE_CODE_EXECUTION=false
ENABLE_CODE_INTERPRETER=false
ENABLE_WEB_SEARCH=false
ENABLE_IMAGE_GENERATION=false
ENABLE_IMAGE_EDIT=false
ENABLE_MEMORIES=false
ENABLE_NOTES=false
ENABLE_CHANNELS=false
ENABLE_CALENDAR=false
ENABLE_AUTOMATIONS=false
ENABLE_USER_WEBHOOKS=false
ENABLE_FORWARD_USER_INFO_HEADERS=false
USER_PERMISSIONS_CHAT_FILE_UPLOAD=false
USER_PERMISSIONS_CHAT_STT=false
USER_PERMISSIONS_CHAT_TTS=false
USER_PERMISSIONS_CHAT_CALL=false
USER_PERMISSIONS_CHAT_SYSTEM_PROMPT=false
USER_PERMISSIONS_CHAT_PARAMS=false
USER_PERMISSIONS_CHAT_WEB_UPLOAD=false
USER_PERMISSIONS_CHAT_VALVES=false
USER_PERMISSIONS_FEATURES_WEB_SEARCH=false
USER_PERMISSIONS_FEATURES_IMAGE_GENERATION=false
USER_PERMISSIONS_FEATURES_CODE_INTERPRETER=false
USER_PERMISSIONS_FEATURES_NOTES=false
USER_PERMISSIONS_FEATURES_CHANNELS=false
USER_PERMISSIONS_FEATURES_MEMORIES=false
USER_PERMISSIONS_FEATURES_CALENDAR=false
USER_PERMISSIONS_WORKSPACE_MODELS_ACCESS=false
USER_PERMISSIONS_WORKSPACE_TOOLS_ACCESS=false
# Background generations: titles only (one short Sonnet call per chat).
ENABLE_TITLE_GENERATION=true
ENABLE_TAGS_GENERATION=false
ENABLE_FOLLOW_UP_GENERATION=false
ENABLE_AUTOCOMPLETE_GENERATION=false
ENABLE_SEARCH_QUERY_GENERATION=false
ENABLE_RETRIEVAL_QUERY_GENERATION=false
