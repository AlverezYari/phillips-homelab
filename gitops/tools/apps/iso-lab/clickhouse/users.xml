<!-- Users replace the image defaults (CLICKHOUSE_SKIP_USER_SETUP=1).
     iso     pipeline: owns database iso, reads the lake via s3(lake, ...).
     iso_ro  MCP servers + Grafana: SELECT on iso.* only, no S3/lake access, hard limits.
             The MCP tools add their own limits; these are the backstop.
     iso_console  the miso-lab portal's live SQL box (people typing arbitrary queries): SELECT on
             iso.* only, its own profile + quota so a heavy query can't starve Grafana, the agent
             tools or the pipeline. Same password as iso_ro (no new secret); separate user so its
             limits, quota and query_log attribution are separate.
     default localhost only (probes, clickhouse-client in the pod). -->
<clickhouse>
    <profiles>
        <!-- Pipeline (dbt): large aggregations and sorts spill to disk past ~1.5 GB instead of
             failing the whole build with "memory limit exceeded". -->
        <pipeline>
            <max_bytes_before_external_group_by>1500000000</max_bytes_before_external_group_by>
            <max_bytes_before_external_sort>1500000000</max_bytes_before_external_sort>
        </pipeline>
        <readonly_agent>
            <readonly>1</readonly>
            <max_execution_time>30</max_execution_time>
            <max_result_rows>100000</max_result_rows>
            <result_overflow_mode>break</result_overflow_mode>
            <max_memory_usage>2000000000</max_memory_usage>
            <max_rows_to_read>2000000000</max_rows_to_read>
            <constraints>
                <!-- Grafana's ClickHouse driver sends max_execution_time = query timeout + 5 s
                     with every query; readonly=1 rejects any setting unless it's marked
                     changeable, and the max keeps the 30 s cap. Datasource queryTimeout <= 25. -->
                <max_execution_time>
                    <max>30</max>
                    <changeable_in_readonly/>
                </max_execution_time>
            </constraints>
        </readonly_agent>
        <!-- Portal SQL console: free to scan everything (that's the point), but bounded per query
             (30 s, 6 of the node's 16 threads, 2 GB) and per user (2 at once). A result over 10,000
             rows is refused (throw: 'break' stops at block boundaries, not exactly at the limit).
             readonly=1, so the browser can't change any of this. The one setting it may set is
             additional_table_filters: Ask's Replay fence (iso_lab.api.ask) cuts every table off at the
             decision time with it. It only ever hides rows, so allowing it gives nothing away. -->
        <console>
            <readonly>1</readonly>
            <max_execution_time>30</max_execution_time>
            <max_threads>6</max_threads>
            <max_memory_usage>2000000000</max_memory_usage>
            <max_concurrent_queries_for_user>2</max_concurrent_queries_for_user>
            <max_rows_to_read>1000000000</max_rows_to_read>
            <max_result_rows>10000</max_result_rows>
            <result_overflow_mode>throw</result_overflow_mode>
            <max_query_size>16384</max_query_size>
            <constraints>
                <additional_table_filters><changeable_in_readonly/></additional_table_filters>
            </constraints>
        </console>
        <!-- Paper desk writer (miso-api): small inserts into desk.* and the D1 settlement read. -->
        <desk>
            <max_execution_time>15</max_execution_time>
            <max_memory_usage>1000000000</max_memory_usage>
            <max_result_rows>100000</max_result_rows>
        </desk>
    </profiles>
    <quotas>
        <!-- 30 queries a minute, 600 an hour, 2 hours of query time a day. -->
        <console>
            <interval><duration>60</duration><queries>30</queries><errors>30</errors><result_rows>0</result_rows><read_rows>0</read_rows><execution_time>0</execution_time></interval>
            <interval><duration>3600</duration><queries>600</queries><errors>0</errors><result_rows>0</result_rows><read_rows>0</read_rows><execution_time>0</execution_time></interval>
            <interval><duration>86400</duration><queries>0</queries><errors>0</errors><result_rows>0</result_rows><read_rows>0</read_rows><execution_time>7200</execution_time></interval>
        </console>
    </quotas>
    <users>
        <default>
            <networks replace="replace">
                <ip>::1</ip>
                <ip>127.0.0.1</ip>
            </networks>
        </default>
        <iso>
            <password from_env="CLICKHOUSE_PASSWORD"/>
            <networks><ip>::/0</ip></networks>
            <profile>pipeline</profile>
            <quota>default</quota>
            <!-- No <grants>: ClickHouse refuses them alongside access-control
                 flags, and a user without grants has full access. -->
            <named_collection_control>1</named_collection_control>
        </iso>
        <iso_ro>
            <password from_env="CLICKHOUSE_RO_PASSWORD"/>
            <networks><ip>::/0</ip></networks>
            <profile>readonly_agent</profile>
            <quota>default</quota>
            <grants>
                <query>GRANT SELECT ON iso.*</query>
                <query>GRANT SELECT ON desk.*</query>
            </grants>
        </iso_ro>
        <iso_console>
            <password from_env="CLICKHOUSE_RO_PASSWORD"/>
            <networks><ip>::/0</ip></networks>
            <profile>console</profile>
            <quota>console</quota>
            <grants>
                <query>GRANT SELECT ON iso.*</query>
                <query>GRANT SELECT ON desk.*</query>
            </grants>
        </iso_console>
        <!-- iso_desk: the paper desk's writer (miso-api). Creates and appends to database desk only
             (orders are an append-only log: a cancel is a new row); reads iso.* to settle. Same
             password as iso_ro (no new secret). -->
        <iso_desk>
            <password from_env="CLICKHOUSE_RO_PASSWORD"/>
            <networks><ip>::/0</ip></networks>
            <profile>desk</profile>
            <quota>default</quota>
            <grants>
                <query>GRANT SELECT ON iso.*</query>
                <query>GRANT SELECT, INSERT, CREATE TABLE, CREATE DATABASE ON desk.*</query>
            </grants>
        </iso_desk>
    </users>
</clickhouse>
