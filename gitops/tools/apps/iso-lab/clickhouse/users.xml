<!-- Users replace the image defaults (CLICKHOUSE_SKIP_USER_SETUP=1).
     iso     pipeline: owns database iso, reads the lake via s3(lake, ...).
     iso_ro  MCP server: SELECT on iso.* only, no S3/lake access, hard limits.
             The MCP tools add their own limits; these are the backstop.
     default localhost only (probes, clickhouse-client in the pod). -->
<clickhouse>
    <profiles>
        <readonly_agent>
            <readonly>1</readonly>
            <max_execution_time>30</max_execution_time>
            <max_result_rows>100000</max_result_rows>
            <result_overflow_mode>break</result_overflow_mode>
            <max_memory_usage>2000000000</max_memory_usage>
            <max_rows_to_read>2000000000</max_rows_to_read>
        </readonly_agent>
    </profiles>
    <users>
        <default>
            <networks replace="replace">
                <ip>::1</ip>
                <ip>127.0.0.1</ip>
            </networks>
        </default>
        <iso>
            <password from_env="CLICKHOUSE_PASSWORD"/>
            <networks><ip>::/0</ip></networks>
            <profile>default</profile>
            <quota>default</quota>
            <!-- No <grants>: ClickHouse refuses them alongside access-control
                 flags, and a user without grants has full access. -->
            <named_collection_control>1</named_collection_control>
        </iso>
        <iso_ro>
            <password from_env="CLICKHOUSE_RO_PASSWORD"/>
            <networks><ip>::/0</ip></networks>
            <profile>readonly_agent</profile>
            <quota>default</quota>
            <grants>
                <query>GRANT SELECT ON iso.*</query>
            </grants>
        </iso_ro>
    </users>
</clickhouse>
