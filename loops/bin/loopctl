#!/usr/bin/env bash
# loopctl — conductor verbs for the loop rig. Deterministic single commands
# so the conductor never improvises multi-step kubectl.
#
#   loopctl spawn <name> <owner/repo> --spec <file> [--max-iter N] [--image TAG] [--engine claude|codex] [--gate CMD]
#   loopctl status [name]
#   loopctl logs <name> [-f]
#   loopctl answer <name> <json-or-text>
#   loopctl pause <name> | resume <name>
#   loopctl reap <name> [--no-pr] [--now]
#   loopctl prune [--keep N] [--dry-run]
#   loopctl pr <owner/repo> <branch> [--body-file FILE] [title...]
#   loopctl merge <owner/repo> <pr#>
#   loopctl conform <owner/repo> <ref> [--pr N]
#   loopctl release <owner/repo> <tag> [title...]
#   loopctl mkrepo <loop-bot/name> [description...]
#
# Secrets never touch the laptop: FJO/NATS calls run in short-lived helper
# pods that read the loop-secrets Secret in-cluster.
set -euo pipefail

NS=loops
REVIEWER=cphillips-homelab
NTFY_URL=${NTFY_URL:-https://ntfy.tail852f61.ts.net/loops}

ping_phone() { # best-effort lifecycle notification (tailnet ntfy)
  curl -s -m 5 -H "Title: $1" -H "Tags: $2" -d "$3" "$NTFY_URL" >/dev/null 2>&1 || true
}
FJO_API=http://forgejo-http.forgejo.svc.cluster.local:3000/api/v1
REPO_ROOT=${LOOPCTL_ROOT:-$(git -C "$(dirname "${BASH_SOURCE[0]}")" rev-parse --show-toplevel 2>/dev/null || echo "$HOME/Documents/Projects/phillips-homelab")}
TEMPLATE="$REPO_ROOT/loops/templates/loop-sandbox.yaml"

die() { echo "loopctl: $*" >&2; exit 1; }

default_image_tag() { sed -n 's/.*# default-image-tag: //p' "$TEMPLATE" | head -1; }
image_from_template() { echo "zot.phillips-homelab.net/loop-dev:$(default_image_tag)"; }

# Run $2 (bash script text) in a short-lived in-cluster pod named loopctl-$1-*
# with loop-secrets in env. Prints the pod's logs. Optional $3 = extra pod
# spec YAML lines (e.g. a PVC volume), $4 = extra container YAML lines.
helper_pod() {
  local verb=$1 script=$2 extra_spec=${3:-} extra_container=${4:-}
  local pod="loopctl-${verb}-$RANDOM"
  {
    echo "apiVersion: v1"
    echo "kind: Pod"
    echo "metadata:"
    echo "  name: ${pod}"
    echo "  namespace: ${NS}"
    echo "spec:"
    echo "  restartPolicy: Never"
    echo "  nodeSelector: {kubernetes.io/hostname: homelab-04}"
    [ -n "$extra_spec" ] && printf '%s\n' "$extra_spec"
    echo "  containers:"
    echo "  - name: c"
    echo "    image: $(image_from_template)"
    echo "    envFrom: [{secretRef: {name: loop-secrets}}]"
    [ -n "$extra_container" ] && printf '%s\n' "$extra_container"
    echo "    command: [bash, -c, $(python3 -c 'import json,sys; print(json.dumps(sys.argv[1]))' "$script")]"
  } | kubectl apply -f - >/dev/null
  # Poll the phase instead of `kubectl wait --for=Succeeded`, which sat out the
  # whole timeout when the pod had already failed.
  local limit=${HELPER_TIMEOUT:-900s} phase=""
  local deadline=$(( $(date +%s) + ${limit%s} ))
  while :; do
    phase=$(kubectl -n "$NS" get pod "$pod" -o jsonpath='{.status.phase}' 2>/dev/null)
    case "$phase" in Succeeded|Failed) break;; esac
    [ "$(date +%s)" -lt "$deadline" ] || { phase=timeout; break; }
    sleep 5
  done
  if [ "$phase" != Succeeded ]; then
    kubectl -n "$NS" logs "$pod" 2>/dev/null
    kubectl -n "$NS" delete pod "$pod" --wait=false >/dev/null 2>&1
    die "helper pod $verb failed ($phase)"
  fi
  kubectl -n "$NS" logs "$pod" 2>/dev/null
  kubectl -n "$NS" delete pod "$pod" --wait=false >/dev/null 2>&1
}

cmd_spawn() {
  local name=${1:?usage: loopctl spawn <name> <owner/repo> --spec <file> [--max-iter N] [--image TAG] [--engine claude|codex] [--gate CMD] [--model M] [--budget-usd N]}
  local repo=${2:?owner/repo required}; shift 2
  # --model: sonnet unless asked; Opus (the CLI default) costs several times
  # more and is for loops that need it. --budget-usd: estimated-spend cap.
  local spec="" max_iter=15 image="" engine=claude gate="" model=sonnet budget=""
  while [ $# -gt 0 ]; do case $1 in
    --spec) spec=$2; shift 2;; --max-iter) max_iter=$2; shift 2;; --image) image=$2; shift 2;;
    --engine) engine=$2; shift 2;; --gate) gate=$2; shift 2;;
    --model) model=$2; shift 2;; --budget-usd) budget=$2; shift 2;;
    *) die "unknown flag $1";;
  esac; done
  [ -f "$spec" ] || die "--spec <file> required and must exist"
  case "$engine" in claude|codex) ;; *) die "--engine must be claude or codex";; esac
  if [ "$engine" = codex ]; then
    kubectl -n "$NS" get secret codex-auth >/dev/null 2>&1 \
      || die "--engine codex needs secret codex-auth (kubectl -n $NS create secret generic codex-auth --from-file=CODEX_AUTH_JSON=\$HOME/.codex/auth.json)"
  fi
  if kubectl -n "$NS" get sandbox "$name" >/dev/null 2>&1; then
    # A reaped loop kept for inspection gives way to a respawn of the same name.
    [ "$(kubectl -n "$NS" get sandbox "$name" -o jsonpath='{.metadata.labels.loop\.phillips\.dev/state}')" = reaped ] \
      || die "sandbox '$name' already exists (reap it first)"
    delete_sandbox "$name"
  fi

  [ -z "$budget" ] || [[ $budget =~ ^[0-9]+(\.[0-9]+)?$ ]] || die "--budget-usd must be a number"
  LOOP=$name REPO=$repo MAX_ITER=$max_iter ENGINE=$engine GATE="${gate:-make build test lint}" \
    MODEL=$model BUDGET_USD=$budget \
    IMAGE="${image:-$(default_image_tag)}" \
    python3 - "$TEMPLATE" <<'EOF' | kubectl apply -f - >/dev/null
import os, re, sys
t = open(sys.argv[1]).read()
print(re.sub(r'\$\{(\w+)\}', lambda m: os.environ[m.group(1)], t))
EOF
  echo "spawned sandbox/$name; waiting for pod..."
  # The sandbox controller creates the pod a moment after the Sandbox; `kubectl
  # wait` on a pod that doesn't exist yet fails at once (NotFound), so wait for
  # it to exist first. The in-cluster conductor spawns fast enough to hit this.
  local w=0
  until kubectl -n "$NS" get "pod/$name" >/dev/null 2>&1; do
    sleep 2; w=$((w+1)); [ $w -gt 90 ] && die "sandbox controller created no pod for $name within 3m"
  done
  kubectl -n "$NS" wait --for=condition=Ready "pod/$name" --timeout=300s >/dev/null
  kubectl -n "$NS" cp "$spec" "$name:/workspace/SPEC.md" >/dev/null 2>&1
  echo "SPEC uploaded; waiting for iteration 1..."
  local i=0
  until kubectl -n "$NS" exec "$name" -- test -f /workspace/.iter-count 2>/dev/null; do
    sleep 3; i=$((i+1)); [ $i -gt 60 ] && die "harness did not start iterating within 3m — check: loopctl logs $name"
  done
  local spend="${budget:+, \$$budget est}"
  echo "loop '$name' running against $repo ($model, budget $max_iter iterations$spend). Watch: loopctl logs $name -f"
  ping_phone "Loop spawned: $name" "arrow_forward" "$repo, $model, budget $max_iter iterations$spend. Decisions and completion will ping here."
}

cmd_status() {
  local name=${1:-}
  if [ -z "$name" ]; then
    echo "SANDBOX      STATE       POD-PHASE   AGE"
    kubectl -n "$NS" get sandboxes -o json 2>/dev/null | python3 -c "
import json,sys,datetime
now = datetime.datetime.now(datetime.timezone.utc)
items = json.load(sys.stdin).get('items', [])
if not items: print('(no loops)'); sys.exit()
for s in items:
    n = s['metadata']['name']
    st = s['metadata'].get('labels', {}).get('loop.phillips.dev/state', '?')
    created = datetime.datetime.fromisoformat(s['metadata']['creationTimestamp'].replace('Z','+00:00'))
    age = str(now - created).split('.')[0]
    print(f'{n:<12} {st:<11} {\"-\":<11} {age}')"
    kubectl -n "$NS" get pods -o wide 2>/dev/null | grep -vE 'loopctl-|nats|bridge' | tail -n +2 || true
    return
  fi
  echo "=== sandbox/$name"
  kubectl -n "$NS" get sandbox "$name" -o jsonpath='state={.metadata.labels.loop\.phillips\.dev/state} mode={.spec.operatingMode} spend=${.metadata.annotations.loop\.phillips\.dev/cost-usd} est ({.metadata.annotations.loop\.phillips\.dev/tokens} tok){"\n"}' 2>/dev/null || { echo "(no such sandbox)"; return; }
  kubectl -n "$NS" get pod "$name" -o wide 2>/dev/null | tail -1 || true
  echo "=== PROGRESS (tail)"
  kubectl -n "$NS" exec "$name" -- sh -c 'echo "iteration: $(cat /workspace/.iter-count 2>/dev/null)/$MAX_ITER"; tail -20 /workspace/PROGRESS.md 2>/dev/null; ls /workspace/decisions/*.json 2>/dev/null | sed "s/^/UNRELAYED DECISION: /"' 2>/dev/null \
    || echo "(pod not exec-able — completed or suspended)"
  echo "=== PR (likely): https://code.phillips-homelab.net/loop-bot/*/pulls — branch loop/$name"
}

cmd_logs() {
  local name=${1:?usage: loopctl logs <name> [-f]}
  shift || true
  kubectl -n "$NS" logs "$name" "$@" --tail=50
}

cmd_answer() {
  local name=${1:?usage: loopctl answer <name> <json-or-text>}
  local msg=${2:?message required}
  echo "$msg" | jq -e . >/dev/null 2>&1 || msg=$(jq -cn --arg a "$msg" '{answer: $a, by: "conductor"}')
  helper_pod answer "nats --server \"nats://loop:\${NATS_PASSWORD}@nats.loops.svc.cluster.local:4222\" pub 'loops.${name}.inbox' '$(printf %s "$msg" | sed "s/'/'\\\\''/g")' && echo 'answer published to loops.${name}.inbox'"
}

cmd_pause()  { kubectl -n "$NS" patch sandbox "${1:?name}" --type=merge -p '{"spec":{"operatingMode":"Suspended"}}' && echo "paused (PVC retained)"; }
cmd_resume() { kubectl -n "$NS" patch sandbox "${1:?name}" --type=merge -p '{"spec":{"operatingMode":"Running"}}' && echo "resumed"; }

# cat: read a file off a loop's workspace PVC, running or reaped-not-yet-
# deleted -- the forensics verb the codex-smoke debugging was missing
# (a Completed pod is not exec-able, and reap deletes the PVC without
# ever showing the iteration logs).
cmd_cat() {
  local name=${1:?usage: loopctl cat <name> <path-relative-to-workspace>}
  local path=${2:?path required}
  kubectl -n "$NS" get pvc "workspace-$name" >/dev/null 2>&1 || die "no PVC workspace-$name"
  helper_pod cat "cat /ws/${path} 2>&1 || echo \"(cannot read /ws/${path})\"" \
      "  volumes:
  - name: ws
    persistentVolumeClaim: {claimName: workspace-$name}" \
      "    volumeMounts: [{name: ws, mountPath: /ws}]"
}

cmd_reap() {
  local name=${1:?usage: loopctl reap <name> [--no-pr]}
  shift; local nopr="" now=""
  while [ $# -gt 0 ]; do case $1 in --no-pr) nopr=--no-pr;; --now) now=1;; *) die "unknown flag $1";; esac; shift; done
  if [ "$nopr" != "--no-pr" ] && kubectl -n "$NS" get pvc "workspace-$name" >/dev/null 2>&1; then
    local repo
    repo=$(kubectl -n "$NS" get sandbox "$name" -o jsonpath='{.spec.podTemplate.spec.containers[0].env[?(@.name=="REPO_URL")].value}' \
      | sed -E 's#.*/([^/]+/[^/]+)\.git#\1#')
    [ -n "$repo" ] || die "cannot derive repo from sandbox env"
    helper_pod reap "
F=$FJO_API
BODY=\$( [ -f /ws/PR.md ] && cat /ws/PR.md || cat /ws/.loop-done 2>/dev/null || echo 'loop reaped' )
PAYLOAD=\$(jq -n --arg b \"\$BODY\" '{title: \"loop(${name})\", head: \"loop/${name}\", base: \"main\", body: \$b}')
code=\$(curl -s -o /tmp/r -w '%{http_code}' -X POST \"\$F/repos/${repo}/pulls\" -H \"Authorization: token \${FORGEJO_TOKEN}\" -H 'Content-Type: application/json' -d \"\$PAYLOAD\")
case \"\$code\" in
  201) idx=\$(jq -r .number /tmp/r); echo \"PR filed: \$(jq -r .html_url /tmp/r)\";;
  409) echo 'PR already exists for branch'; idx=\$(curl -s \"\$F/repos/${repo}/pulls?state=open\" -H \"Authorization: token \${FORGEJO_TOKEN}\" | jq -r '.[] | select(.head.ref==\"loop/${name}\") | .number' | head -1);;
  *) echo \"PR create failed: \$code\"; head -c 200 /tmp/r; idx='';;
esac
if [ -n \"\$idx\" ]; then
  jq -n --arg p \"\$(cat /ws/PROGRESS.md 2>/dev/null || echo none)\" '{body: (\"## Final PROGRESS (forensics)\n\n\" + \$p)}' \
    | curl -s -o /dev/null -X POST \"\$F/repos/${repo}/issues/\$idx/comments\" -H \"Authorization: token \${FORGEJO_TOKEN}\" -H 'Content-Type: application/json' -d @-
  curl -s -o /dev/null -X POST \"\$F/repos/${repo}/pulls/\$idx/requested_reviewers\" -H \"Authorization: token \${FORGEJO_TOKEN}\" -H 'Content-Type: application/json' -d '{\"reviewers\":[\"$REVIEWER\"]}'
  echo 'PROGRESS attached as comment; review requested from $REVIEWER'
  # Visual confirmations: UI loops drop PNGs in /workspace/renders/
  # (SPEC contract, added after a restyle shipped green gates but was
  # visually broken). Upload each as a PR attachment and embed them in
  # one comment so review OPENS with pictures next to the diff.
  if ls /ws/renders/*.png >/dev/null 2>&1; then
    IMGS=''
    for f in /ws/renders/*.png; do
      url=\$(curl -s -X POST \"\$F/repos/${repo}/issues/\$idx/assets?name=\$(basename \"\$f\")\" -H \"Authorization: token \${FORGEJO_TOKEN}\" -F \"attachment=@\$f\" | jq -r '.browser_download_url // empty')
      [ -n \"\$url\" ] && IMGS=\"\$IMGS![\$(basename \"\$f\")](\$url)\n\n\"
    done
    if [ -n \"\$IMGS\" ]; then
      jq -n --arg b \"\$(printf '## Visual confirmations\n\n%b' \"\$IMGS\")\" '{body: \$b}' \
        | curl -s -o /dev/null -X POST \"\$F/repos/${repo}/issues/\$idx/comments\" -H \"Authorization: token \${FORGEJO_TOKEN}\" -H 'Content-Type: application/json' -d @-
      echo 'visual confirmations attached'
    fi
  fi
fi" \
      "  volumes:
  - name: ws
    persistentVolumeClaim: {claimName: workspace-$name}" \
      "    volumeMounts: [{name: ws, mountPath: /ws}]"
  fi
  if [ -n "$now" ]; then
    delete_sandbox "$name"
    ping_phone "Loop reaped: $name" "package" "Sandbox deleted; PR (if any) is review-requested in FJO."
    return
  fi
  # Snake tail: a reaped loop stays on the board, suspended with its PVC, so
  # it can be inspected (loopctl resume / helper pod) for a while. prune drops
  # the oldest reaped loops beyond the newest $KEEP.
  kubectl -n "$NS" patch sandbox "$name" --type=merge -p '{"spec":{"operatingMode":"Suspended"}}' >/dev/null
  kubectl -n "$NS" label sandbox "$name" --overwrite loop.phillips.dev/state=reaped >/dev/null
  kubectl -n "$NS" annotate sandbox "$name" --overwrite "loop.phillips.dev/reaped-at=$(date -u +%Y-%m-%dT%H:%M:%SZ)" >/dev/null
  echo "sandbox suspended and kept for inspection (PVC retained)"
  cmd_prune
  ping_phone "Loop reaped: $name" "package" "Sandbox kept (suspended) for inspection; PR (if any) is review-requested in FJO."
}

delete_sandbox() {
  local name=$1
  kubectl -n "$NS" delete sandbox "$name" >/dev/null && echo "sandbox $name deleted"
  sleep 5
  kubectl -n "$NS" get pvc "workspace-$name" >/dev/null 2>&1 && echo "WARNING: PVC workspace-$name still present" || echo "PVC workspace-$name cleaned up"
}

# prune: keep the newest $KEEP reaped loops (default 4, LOOP_KEEP overrides),
# delete older ones with their PVCs. Loops left finished but never reaped
# (done/failed/exhausted/stopped/budget) are pruned once older than 7 days.
# Running, starting and blocked loops are never touched.
cmd_prune() {
  local keep=${LOOP_KEEP:-4} dry=""
  while [ $# -gt 0 ]; do case $1 in --keep) keep=$2; shift 2;; --dry-run) dry=1; shift;; *) die "unknown flag $1";; esac; done
  [[ $keep =~ ^[0-9]+$ ]] || die "--keep must be a number"
  local victims
  victims=$(kubectl -n "$NS" get sandboxes -o json | KEEP=$keep python3 -c "
import json, os, sys, datetime
now = datetime.datetime.now(datetime.timezone.utc)
ts = lambda v: datetime.datetime.fromisoformat(v.replace('Z', '+00:00'))
reaped, stale = [], []
for s in json.load(sys.stdin).get('items', []):
    m = s['metadata']
    st = m.get('labels', {}).get('loop.phillips.dev/state', '')
    created = ts(m['creationTimestamp'])
    if st == 'reaped':
        reaped.append((ts(m.get('annotations', {}).get('loop.phillips.dev/reaped-at', m['creationTimestamp'])), m['name']))
    elif (st in ('done', 'failed', 'exhausted', 'stopped') or st.startswith('budget')) and now - created > datetime.timedelta(days=7):
        stale.append(m['name'])
reaped.sort(reverse=True)
for _, n in reaped[int(os.environ['KEEP']):]: print(n)
for n in stale: print(n)
")
  [ -n "$victims" ] || { echo "prune: nothing to remove (keeping newest $keep reaped)"; return 0; }
  for v in $victims; do
    if [ -n "$dry" ]; then echo "would delete $v"; else delete_sandbox "$v"; fi
  done
}

# pr/merge: the conductor's landing verbs. reap files a PR only for a
# loop's own branch on its way out; these work for ANY branch/PR (fix
# branches, docs branches, a reaped loop's PR after review), so the
# conductor never has to improvise raw token curls — the FJO token
# stays in-cluster, same invariant as every other verb.
cmd_pr() {
  local repo=${1:?usage: loopctl pr <owner/repo> <branch> [--body-file FILE] [title...]}
  local branch=${2:?branch required}; shift 2
  local bodyfile=""
  if [ "${1:-}" = "--body-file" ]; then
    bodyfile=${2:?--body-file needs a path}; shift 2
    [ -f "$bodyfile" ] || die "--body-file $bodyfile not found"
  fi
  local title=${*:-$branch}
  local body
  body=$( [ -n "$bodyfile" ] && cat "$bodyfile" || echo "Filed by loopctl pr." )
  # Body rides in as a pod env var (same route as cmd_issue) so it never
  # goes through shell quoting inside the helper script. If the PR already
  # exists and a body file was given, the body is replaced, so a reap's
  # placeholder or an earlier bare `pr` can be filled in afterwards.
  helper_pod pr "
F=$FJO_API
PAYLOAD=\$(jq -n --arg t \"$title\" --arg h \"$branch\" --arg b \"\$PR_BODY\" '{title: \$t, head: \$h, base: \"main\", body: \$b}')
code=\$(curl -s -o /tmp/r -w '%{http_code}' -X POST \"\$F/repos/${repo}/pulls\" -H \"Authorization: token \${FORGEJO_TOKEN}\" -H 'Content-Type: application/json' -d \"\$PAYLOAD\")
case \"\$code\" in
  201) echo \"PR #\$(jq -r .number /tmp/r) filed: \$(jq -r .html_url /tmp/r)\";;
  409) idx=\$(curl -s \"\$F/repos/${repo}/pulls?state=open\" -H \"Authorization: token \${FORGEJO_TOKEN}\" | jq -r '.[] | select(.head.ref==\"${branch}\") | .number' | head -1)
       if [ -n \"\$PR_BODY_FROM_FILE\" ] && [ -n \"\$idx\" ]; then
         pcode=\$(jq -n --arg b \"\$PR_BODY\" '{body: \$b}' | curl -s -o /tmp/p -w '%{http_code}' -X PATCH \"\$F/repos/${repo}/pulls/\$idx\" -H \"Authorization: token \${FORGEJO_TOKEN}\" -H 'Content-Type: application/json' -d @-)
         echo \"PR already exists: #\$idx; body updated (\$pcode)\"
       else
         echo \"PR already exists: #\$idx\"
       fi;;
  *) echo \"PR create failed: \$code\"; head -c 300 /tmp/r; exit 1;;
esac" "" "    env:
    - name: PR_BODY
      value: $(python3 -c 'import json,sys; print(json.dumps(sys.argv[1]))' "$body")
    - name: PR_BODY_FROM_FILE
      value: \"${bodyfile:+1}\""
}

cmd_issue() {
  local repo=${1:?usage: loopctl issue <owner/repo> <title> <body-file>}
  local title=${2:?title required}
  local bodyfile=${3:?body-file required}
  local body
  body=$(cat "$bodyfile")
  helper_pod issue "
F=$FJO_API
PAYLOAD=\$(jq -n --arg t \"$title\" --arg b \"\$ISSUE_BODY\" '{title: \$t, body: \$b}')
code=\$(curl -s -o /tmp/r -w '%{http_code}' -X POST \"\$F/repos/${repo}/issues\" -H \"Authorization: token \${FORGEJO_TOKEN}\" -H 'Content-Type: application/json' -d \"\$PAYLOAD\")
case \"\$code\" in
  201) echo \"issue #\$(jq -r .number /tmp/r) filed: \$(jq -r .html_url /tmp/r)\";;
  *) echo \"issue create failed: \$code\"; head -c 300 /tmp/r; exit 1;;
esac" "" "    env:
    - name: ISSUE_BODY
      value: $(python3 -c 'import json,sys; print(json.dumps(sys.argv[1]))' "$body")"
}

# mkrepo: create a private loop-bot repo and add the reviewer as admin
# collaborator (needed for OFFICIAL reviews under branch protection).
# Idempotent: an existing repo just gets the collaborator check.
cmd_mkrepo() {
  local repo=${1:?usage: loopctl mkrepo <loop-bot/name> [description...]}; shift
  local owner=${repo%%/*} name=${repo#*/}
  [ "$owner" = loop-bot ] || die "mkrepo creates repos as loop-bot only (got owner '$owner')"
  local desc=${*:-}
  helper_pod mkrepo "
F=$FJO_API
PAYLOAD=\$(jq -n --arg n \"$name\" --arg d \"$desc\" '{name: \$n, description: \$d, private: true, default_branch: \"main\", auto_init: false}')
code=\$(curl -s -o /tmp/r -w '%{http_code}' -X POST \"\$F/user/repos\" -H \"Authorization: token \${FORGEJO_TOKEN}\" -H 'Content-Type: application/json' -d \"\$PAYLOAD\")
case \"\$code\" in
  201) echo \"created \$(jq -r .full_name /tmp/r): \$(jq -r .ssh_url /tmp/r)\";;
  409) echo 'repo already exists';;
  *) echo \"repo create failed: \$code\"; head -c 300 /tmp/r; exit 1;;
esac
code=\$(curl -s -o /tmp/c -w '%{http_code}' -X PUT \"\$F/repos/${repo}/collaborators/$REVIEWER\" -H \"Authorization: token \${FORGEJO_TOKEN}\" -H 'Content-Type: application/json' -d '{\"permission\":\"admin\"}')
case \"\$code\" in
  204) echo 'collaborator $REVIEWER: admin';;
  *) echo \"collaborator add failed: \$code\"; head -c 300 /tmp/c; exit 1;;
esac"
}

cmd_issue() {
  local repo=${1:?usage: loopctl issue <owner/repo> <title> <body-file>}
  local title=${2:?title required}
  local bodyfile=${3:?body-file required}
  local body
  body=$(cat "$bodyfile")
  helper_pod issue "
F=$FJO_API
PAYLOAD=\$(jq -n --arg t \"$title\" --arg b \"\$ISSUE_BODY\" '{title: \$t, body: \$b}')
code=\$(curl -s -o /tmp/r -w '%{http_code}' -X POST \"\$F/repos/${repo}/issues\" -H \"Authorization: token \${FORGEJO_TOKEN}\" -H 'Content-Type: application/json' -d \"\$PAYLOAD\")
case \"\$code\" in
  201) echo \"issue #\$(jq -r .number /tmp/r) filed: \$(jq -r .html_url /tmp/r)\";;
  *) echo \"issue create failed: \$code\"; head -c 300 /tmp/r; exit 1;;
esac" "" "    env:
    - name: ISSUE_BODY
      value: $(python3 -c 'import json,sys; print(json.dumps(sys.argv[1]))' "$body")"
}

cmd_merge() {
  local repo=${1:?usage: loopctl merge <owner/repo> <pr#>}
  local idx=${2:?PR number required}
  helper_pod merge "
F=$FJO_API
code=\$(curl -s -o /tmp/r -w '%{http_code}' -X POST \"\$F/repos/${repo}/pulls/${idx}/merge\" -H \"Authorization: token \${FORGEJO_TOKEN}\" -H 'Content-Type: application/json' -d '{\"Do\":\"merge\"}')
if [ \"\$code\" = 200 ]; then echo \"PR #${idx} merged\"; else echo \"merge failed: \$code\"; head -c 300 /tmp/r; exit 1; fi"
}

# close: retire a PR without merging (review-loop reaps auto-file PRs
# for branches that only carry a REVIEW.md; those need closing, not
# merging). Same in-cluster token invariant as pr/merge.
# conform: run a repo's conformance stack (conformance/k8s at <ref>) in the
# gitops-owned kindling-conformance namespace, print the driver's report and
# post it on the PR. Contract: loop-bot/kindling docs/specs/build-conformance-run.md.
# The helper pod runs as loops/conformance-runner (namespace admin there only),
# so the token and the stack both stay in-cluster.
cmd_conform() {
  local repo=${1:?usage: loopctl conform <owner/repo> <ref> [--pr N]}
  local ref=${2:?ref required}; shift 2
  local pr=""
  while [ $# -gt 0 ]; do case $1 in --pr) pr=$2; shift 2;; *) die "unknown flag $1";; esac; done
  [[ $ref =~ ^[A-Za-z0-9._/-]+$ ]] || die "ref has unexpected characters"
  [ -z "$pr" ] || [[ $pr =~ ^[0-9]+$ ]] || die "--pr must be a number"
  HELPER_TIMEOUT=6000s helper_pod conform "
set -uo pipefail
F=$FJO_API
CNS=kindling-conformance
URL=http://forgejo-http.forgejo.svc.cluster.local:3000/${repo}.git
# The auth header goes through git's env config, never argv, so /proc/<pid>/cmdline can't show the token.
export GIT_CONFIG_COUNT=1 GIT_CONFIG_KEY_0=http.extraHeader GIT_CONFIG_VALUE_0=\"Authorization: token \${FORGEJO_TOKEN}\"
git clone -q \"\$URL\" /tmp/src
cd /tmp/src
# A sha (full or abbreviated) reachable from any branch resolves in the clone; otherwise fetch the ref by name.
if c=\$(git rev-parse -q --verify '${ref}^{commit}'); then git checkout -q \"\$c\"
elif git fetch -q origin '${ref}'; then git checkout -q FETCH_HEAD
else echo 'conform: cannot check out ${ref}'; exit 1; fi
SHA=\$(git rev-parse HEAD)
# The namespace belongs to gitops: a base that declares it would be deleted on teardown.
if kubectl kustomize conformance/k8s | grep -q '^kind: Namespace\$'; then echo 'conform: conformance/k8s declares the Namespace; refusing'; exit 1; fi
kubectl -n \$CNS delete -k conformance/k8s --ignore-not-found --wait=true >/dev/null 2>&1
kubectl -n \$CNS delete configmap conformance-ref --ignore-not-found >/dev/null
kubectl -n \$CNS create configmap conformance-ref --from-literal=REPO_URL=\"\$URL\" --from-literal=REF=\"\$SHA\" >/dev/null
kubectl -n \$CNS apply -k conformance/k8s >/dev/null || { echo 'conform: apply failed'; exit 1; }
end=\$((\$(date +%s) + 5400)); state=timeout
while [ \$(date +%s) -lt \$end ]; do
  c=\$(kubectl -n \$CNS get job driver -o jsonpath='{.status.conditions[?(@.status==\"True\")].type}' 2>/dev/null)
  case \"\$c\" in *Complete*) state=complete; break;; *Failed*) state=failed; break;; esac
  sleep 20
done
kubectl -n \$CNS logs job/driver -c driver 2>/dev/null > /tmp/log
sed -n '/^===== KINDLING CONFORMANCE REPORT BEGIN =====\$/,/^===== KINDLING CONFORMANCE REPORT END =====\$/p' /tmp/log | sed '1d;\$d' > /tmp/report.md
[ -s /tmp/report.md ] || { echo \"(no report; driver \$state)\" > /tmp/report.md; kubectl -n \$CNS get pods >> /tmp/report.md 2>&1; tail -40 /tmp/log >> /tmp/report.md; }
echo \"conformance \$state at ${ref} (\$SHA)\"
cat /tmp/report.md
if [ -n '${pr}' ]; then
  jq -n --arg b \"\$(printf '## Conformance: %s at \\x60%s\\x60\\n\\n' \"\$state\" \"\$SHA\"; head -c 60000 /tmp/report.md)\" '{body: \$b}' \\
    | curl -s -o /dev/null -X POST \"\$F/repos/${repo}/issues/${pr}/comments\" -H \"Authorization: token \${FORGEJO_TOKEN}\" -H 'Content-Type: application/json' -d @-
  echo 'report posted on PR #${pr}'
fi
kubectl -n \$CNS delete -k conformance/k8s --wait=false >/dev/null 2>&1
kubectl -n \$CNS delete configmap conformance-ref --ignore-not-found >/dev/null
[ \"\$state\" = complete ]" "  serviceAccountName: conformance-runner"
}

cmd_close() {
  local repo=${1:?usage: loopctl close <owner/repo> <pr#>}
  local idx=${2:?PR number required}
  helper_pod close "
F=$FJO_API
code=\$(curl -s -o /tmp/r -w '%{http_code}' -X PATCH \"\$F/repos/${repo}/pulls/${idx}\" -H \"Authorization: token \${FORGEJO_TOKEN}\" -H 'Content-Type: application/json' -d '{\"state\":\"closed\"}')
if [ \"\$code\" = 201 ] || [ \"\$code\" = 200 ]; then echo \"PR #${idx} closed\"; else echo \"close failed: \$code\"; head -c 300 /tmp/r; exit 1; fi"
}

# release: cut a Forgejo release with cross-built client binaries. The
# build runs inside the helper pod (loop-dev carries Go), so source,
# toolchain and token all stay in-cluster -- the same invariant every
# other verb keeps. The pod body lives in release-build.sh rather than
# inline here; nesting a build script inside this file's quoting was
# unreadable and quietly broke.
cmd_release() {
  local repo=${1:?usage: loopctl release <owner/repo> <tag> [title...]}
  local tag=${2:?tag required}; shift 2
  local title=${*:-$tag}
  local body
  body=$(cat "$REPO_ROOT/loops/bin/release-build.sh")
  helper_pod release "$body" "" "    env:
    - {name: REPO, value: \"$repo\"}
    - {name: TAG, value: \"$tag\"}
    - {name: TITLE, value: \"$title\"}"
}

cmd=${1:-help}; shift || true
case $cmd in
  spawn) cmd_spawn "$@";;
  status) cmd_status "$@";;
  logs) cmd_logs "$@";;
  answer) cmd_answer "$@";;
  pause) cmd_pause "$@";;
  resume) cmd_resume "$@";;
  reap) cmd_reap "$@";;
  prune) cmd_prune "$@";;
  cat) cmd_cat "$@";;
  pr) cmd_pr "$@";;
  issue) cmd_issue "$@";;
  merge) cmd_merge "$@";;
  conform) cmd_conform "$@";;
  close) cmd_close "$@";;
  release) cmd_release "$@";;
  mkrepo) cmd_mkrepo "$@";;
  *) sed -n '2,17p' "$0";;
esac
